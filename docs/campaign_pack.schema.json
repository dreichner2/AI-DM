          "type": "string",
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "maxLength": 80
        },
        "playerTitle": {
          "type": "string",
          "maxLength": 160
        },
        "playerSummary": {
          "type": "string",
          "maxLength": 2000
        },
        "terminal": {
          "type": "boolean",
          "default": false
        },
        "chapter": {
          "type": "string",
          "maxLength": 120
        },
        "act": {
          "type": "string",
          "maxLength": 120
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "gate": {
          "enum": ["soft", "hard", "optional", "none"]
        },
        "canCompleteOutOfOrder": {
          "type": "boolean",
          "default": false
        },
        "visibleToPlayers": {
          "type": "boolean"
        },
        "hiddenToPlayers": {
          "type": "boolean"
        },
        "locationIds": {
          "$ref": "#/$defs/idList"
        },
        "questIds": {
          "$ref": "#/$defs/idList"
        },
        "npcIds": {
          "$ref": "#/$defs/idList"
        },
        "encounterIds": {
          "$ref": "#/$defs/idList"
        },
        "objectiveIds": {
          "$ref": "#/$defs/idList"
        },
        "segmentIds": {
          "$ref": "#/$defs/idList"
        },
        "clueIds": {
          "$ref": "#/$defs/idList"
        },
        "nextCheckpointIds": {
          "$ref": "#/$defs/idList"
        },
        "branchWhen": {
          "description": "Makes this checkpoint eligible for automatic branch selection only when the authoritative flag predicate matches.",
          "$ref": "#/$defs/flagPredicate"
        },
        "alternateCheckpointIds": {
          "$ref": "#/$defs/idList"
        },
        "prerequisiteCheckpointIds": {
          "$ref": "#/$defs/idList"
        },
        "prerequisitePolicy": {
          "enum": ["completed", "completed_or_skipped", "completed_or_skipped_or_failed", "terminal"]
        },
        "failureCheckpointIds": {
          "$ref": "#/$defs/idList"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "canFail": {
          "type": "boolean",
          "default": false
        },
        "rejoinTargetCheckpointId": {
          "$ref": "#/$defs/id"
        },
        "completeWhen": {
          "description": "When present, only these conditions complete the checkpoint; any one of them suffices. Other keys (for example summary) are ignored.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "locationIds": {
              "description": "The party is at one of these locations.",
              "$ref": "#/$defs/idList"
            },
            "segmentIds": {
              "description": "One of these segments has triggered.",
              "$ref": "#/$defs/idList"
            },
            "objectiveIds": {
              "description": "One of these objectives is completed (scoped to questIds when given).",
              "$ref": "#/$defs/idList"
            },
            "questIds": {
              "description": "One of these quests is completed.",
              "$ref": "#/$defs/idList"
            },
            "encounterIds": {
              "description": "One of these pack encounters ended with an allowed outcome.",
              "$ref": "#/$defs/idList"
            },
            "clueIds": {
              "description": "All of these clues have been discovered.",
              "$ref": "#/$defs/idList"
            },
            "flags": {
              "description": "All of these flags match the authoritative flags, with branchWhen comparison rules.",
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean"]
              }
            },
            "anyOf": {
              "description": "Encounter outcome labels (defeat, flee, surrender, bargain, negotiate, objective, resolve, success, ...). Prose sentences are ignored.",
              "type": "array"
            }
          }
        },
        "failWhen": {
          "description": "Reads only questIds, objectiveIds and encounterIds; other keys are ignored.",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "questIds": {
              "$ref": "#/$defs/idList"
            },
            "objectiveIds": {
              "$ref": "#/$defs/idList"
            },
            "encounterIds": {
              "$ref": "#/$defs/idList"
            }
          }
        },
        "gmNotes": {
          "description": "Stored with the checkpoint for operators; never shown to players.",
          "$ref": "#/$defs/gmNotes"
        },
        "directorRules": {
          "$ref": "#/$defs/directorRules"
        }
      }
    },
    "directorRules": {
      "description": "Only the six listed keys (or their snake_case forms) are read; any other key is ignored and reported by the linter.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mainQuestGeneration": {
          "enum": ["pack_only", "allowed_tagged", "open"]
        },
        "sideQuestGeneration": {
          "enum": ["allowed_tagged", "blocked", "open", "pack_only"]
        },
        "newNpcs": {
          "enum": ["allowed_as_minor_or_temporary", "blocked", "open", "pack_only"]
        },
        "newLocations": {
          "enum": ["allowed_as_local_detail", "blocked", "open", "pack_only"]
        },
        "offTrackPolicy": {
          "enum": ["improvise_and_reconnect", "strict", "open"]
        },
        "checkpointStyle": {
          "enum": ["soft", "guided", "strict"]
        }
      }
    },
    "dependency": {
      "type": "object",
