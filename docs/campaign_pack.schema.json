{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidm.local/schemas/campaign-pack.schema.json",
  "title": "AIDM Campaign Pack",
  "description": "Structured adventure module import format for AIDM campaigns. Every record, startingState, directorRules, gmNotes, hiddenSceneNotes and marketplace value is bounded on import: containers may nest at most 12 levels below the record (the record itself is level 0), strings may be at most 4000 characters, objects at most 80 keys (keys at most 120 characters) and lists at most 150 items. Content beyond a bound is rejected with error_code pack_content_out_of_bounds and its JSON path; nothing is truncated.",
  "type": "object",
  "additionalProperties": true,
  "required": ["packId", "title"],
  "properties": {
    "schemaVersion": {
      "description": "Campaign pack schema version. AIDM currently accepts 1, 1.0, and 1.0.0 as version 1.",
      "type": ["string", "number"],
      "enum": ["1", "1.0", "1.0.0", 1]
    },
    "packId": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "maxLength": 80,
      "default": "1.0.0"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "world": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        }
      }
    },
    "startingState": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "locationId": {
          "$ref": "#/$defs/id"
        },
        "questId": {
          "$ref": "#/$defs/id"
        },
        "checkpointId": {
          "description": "Initial active checkpoint; defaults to the first checkpoint.",
          "$ref": "#/$defs/id"
        },
        "currentScene": {
          "$ref": "#/$defs/currentScene"
        },
        "knownLocationIds": {
          "$ref": "#/$defs/idList"
        },
        "knownNpcIds": {
          "$ref": "#/$defs/idList"
        },
        "activeNpcIds": {
          "$ref": "#/$defs/idList"
        },
        "knownQuestIds": {
          "$ref": "#/$defs/idList"
        },
        "activeQuestIds": {
          "$ref": "#/$defs/idList"
        },
        "flags": {
          "description": "Copied verbatim into the session's authoritative flags.",
          "type": "object",
          "additionalProperties": true
        },
        "campaignFlags": {
          "description": "Accepted alias of flags; keys in flags win on conflict. Prefer flags.",
          "type": "object",
          "additionalProperties": true
        },
        "partyStatus": {
          "description": "GM-only starting brief, stored at campaignPack.startingBrief.partyStatus. Never shown to players."
        },
        "partyNotes": {
          "description": "GM-only starting brief, stored at campaignPack.startingBrief.partyNotes. Never shown to players.",
          "$ref": "#/$defs/gmNotes"
        },
        "partyNpcs": {
          "type": "array",
          "maxItems": 150,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "combat": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "locations": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "npcs": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/npc"
      }
    },
    "quests": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "enemies": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/enemy"
      }
    },
    "encounters": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/encounter"
      }
    },
    "segments": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "checkpoints": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "clues": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/packRecord"
      }
    },
    "factions": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/packRecord"
      }
    },
    "maps": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/packRecord"
      }
    },
    "handouts": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/packRecord"
      }
    },
    "lore": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/packRecord"
      }
    },
    "directorRules": {
      "$ref": "#/$defs/directorRules"
    },
    "multiSessionGroupKey": {
      "$ref": "#/$defs/id"
    },
    "gmNotes": {
      "$ref": "#/$defs/gmNotes"
    },
    "hiddenSceneNotes": {
      "$ref": "#/$defs/gmNotes"
    },
    "dependencies": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "mods": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/mod"
      }
    },
    "marketplace": {
      "type": "object",
      "additionalProperties": true
    },
    "merchants": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "$ref": "#/$defs/merchant"
      }
    },
    "storyFlags": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/storyFlag"
      }
    },
    "map": {
      "description": "World map settings: title, terrain and the layout seed.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "terrain": {
          "type": "string",
          "enum": ["moor", "forest", "mountain", "coast", "plains", "marsh"]
        },
        "seed": {
          "type": "integer"
        }
      }
    },
    "routes": {
      "description": "Route styles between connected locations (default road for every adjacency).",
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/route"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "idList": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "objectList": {
      "type": "array",
      "maxItems": 150,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "questPredicate": {
      "description": "Quest objective predicate evaluated by the quest engine after every applied change. Event keys (eventType|event|changeType, actorId, targetActorId, targetId, objectId, itemId, itemName, npcId, locationId, encounterId, participantId, endReason, flagKey, checkpointId, objectiveId, questId, quantityAtLeast|amountAtLeast) match the applied change exactly (strings case-insensitively). State keys (atLocationId; locationId and flagKey + flagValue|equals when no event type is given; possessesItemId|possessesItemName with optional actorId and quantityAtLeast; objectiveIds + objectivePolicy all|any) are checked against the state after the change. Event and state keys in one predicate must all hold. all|allOf and any|anyOf hold lists of predicates; entries that are not objects are ignored and a combinator with no predicate is never satisfied; other keys next to a combinator are ignored. Any other key is ignored by the engine and reported by the linter.",
      "properties": {
        "all": {
          "items": {
            "$ref": "#/$defs/questPredicate"
          }
        },
        "allOf": {
          "items": {
            "$ref": "#/$defs/questPredicate"
          }
        },
        "any": {
          "items": {
            "$ref": "#/$defs/questPredicate"
          }
        },
        "anyOf": {
          "items": {
            "$ref": "#/$defs/questPredicate"
          }
        }
      }
    },
    "flagPredicate": {
      "description": "A fail-closed predicate evaluated against the persisted authoritative state flags. It does not inspect narration or model output.",
      "type": "object",
      "additionalProperties": false,
      "required": ["flagKey", "equals"],
      "properties": {
        "flagKey": {
          "$ref": "#/$defs/id"
        },
        "equals": {
          "type": ["string", "number", "boolean"]
        }
      }
    },
    "sourceFields": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "const": "campaign_pack"
        },
        "packId": {
          "$ref": "#/$defs/id"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "packRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceFields"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string",
              "maxLength": 160
            },
            "name": {
              "type": "string",
              "maxLength": 160
            },
            "summary": {
              "type": "string",
              "maxLength": 4000
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "status": {
              "type": "string",
              "maxLength": 80
            },
            "visibleAtStart": {
              "type": "boolean"
            },
            "hiddenToPlayers": {
              "type": "boolean"
            },
            "knownToPlayers": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "location": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceFields"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "maxLength": 160
            },
            "type": {
              "type": "string",
              "maxLength": 80
            },
            "status": {
              "type": "string",
              "maxLength": 80
            },
            "description": {
              "type": "string",
              "maxLength": 4000
            },
            "connectedLocationIds": {
              "description": "The only adjacency structured travel uses. A location without it cannot be reached or left by structured travel.",
              "$ref": "#/$defs/idList"
            },
            "npcIds": {
              "description": "Merged into the scene's active NPCs on arrival.",
              "$ref": "#/$defs/idList"
            },
            "questIds": {
              "description": "Merged into the scene's active quests on arrival.",
              "$ref": "#/$defs/idList"
            },
            "items": {
              "$ref": "#/$defs/objectList"
            },
            "interactables": {
              "description": "Doors, locks, containers and objects restored into the scene on arrival (and at the start when this is the starting location and the starting scene lists none).",
              "$ref": "#/$defs/objectList"
            },
            "hazards": {
              "$ref": "#/$defs/objectList"
            },
            "sceneState": {
              "description": "Optional scene-local overrides; a collection here wins over the top-level one.",
              "type": "object",
              "additionalProperties": true
            },
            "gmNotes": {
              "description": "Stored in the operator catalog only; never sent to players or the DM prompt.",
              "$ref": "#/$defs/gmNotes"
            },
            "visibleAtStart": {
              "type": "boolean"
            },
            "onEnter": {
              "description": "Trusted consequences applied once, on the first arrival.",
              "$ref": "#/$defs/encounterConsequenceList"
            },
            "restPolicy": {
              "type": "string",
              "enum": ["safe", "risky", "none"]
            },
            "mapPosition": {
              "description": "Position on the 0-100 world map grid; computed at import when missing.",
              "type": "object",
              "additionalProperties": false,
              "required": ["x", "y"],
              "properties": {
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            },
            "mapIcon": {
              "type": "string",
              "enum": ["inn", "town", "road", "bridge", "ruin", "tower", "forest", "cave", "camp", "shrine", "cairn", "valley", "gate", "marsh", "peak", "unknown"]
            }
          }
        }
      ]
    },
    "npc": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceFields"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "name"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "role": {
              "type": "string",
              "maxLength": 160
            },
            "disposition": {
              "type": "string",
              "maxLength": 80
            },
            "locationId": {
              "$ref": "#/$defs/id"
            },
            "questIds": {
              "$ref": "#/$defs/idList"
            },
            "description": {
              "description": "Shown to players when no playerDescription is set.",
              "type": "string",
              "maxLength": 4000
            },
            "personality": {
              "description": "Stored in the operator catalog only; never shown to players."
            },
            "motivation": {
              "description": "Stored in the operator catalog only; never shown to players."
            },
            "knows": {
              "description": "Stored in the operator catalog only; never shown to players."
            },
            "secret": {
              "description": "Stored in the operator catalog only; never shown to players. A boolean true (or a yes/true string) instead hides the whole NPC from players."
            },
            "useInPlay": {
              "description": "Stored in the operator catalog only; never shown to players."
            },
            "ifSkipped": {
              "description": "Stored in the operator catalog only; never shown to players."
            },
            "gmNotes": {
              "description": "Stored in the operator catalog only; never shown to players.",
              "$ref": "#/$defs/gmNotes"
            },
            "trueName": {
              "description": "Stored in the operator catalog only; never shown to players."
            },
            "visibleAtStart": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "quest": {
      "allOf": [
        {
          "$ref": "#/$defs/sourceFields"
        },
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["id", "title"],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "status": {
              "type": "string",
              "maxLength": 80,
              "default": "available"
            },
            "stage": {
              "type": "string",
              "maxLength": 160
            },
            "summary": {
              "type": "string",
              "maxLength": 4000
            },
            "objectives": {
              "type": "array",
              "maxItems": 150,
              "items": {
                "$ref": "#/$defs/objective"
              }
            },
            "visibleAtStart": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "description"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "maxLength": 80,
          "default": "open"
        },
        "optional": {
          "type": "boolean"
        },
        "prerequisiteObjectiveIds": {
          "description": "Objectives of the same quest that must be completed first; until then this objective is blocked.",
          "$ref": "#/$defs/idList"
        },
        "completeWhen": {
          "description": "An objective with no completeWhen, failWhen or prerequisites can only be completed by an operator; narration cannot complete it.",
          "$ref": "#/$defs/questPredicate"
        },
        "failWhen": {
          "$ref": "#/$defs/questPredicate"
        }
      }
    },
    "enemy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "creatureType": {
          "type": "string",
          "maxLength": 80
        },
        "challengeTier": {
          "type": "string",
          "maxLength": 80
        },
        "locationIds": {
          "$ref": "#/$defs/idList"
        },
        "factionIds": {
          "$ref": "#/$defs/idList"
        },
        "tags": {
          "type": "array",
          "maxItems": 150,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "encounterRewardSpec": {
      "description": "Compact reward object or explicit typed reward records. Supported rewards include XP, currency, items, flags, and quest events.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": true
        },
        {
          "type": "array",
          "maxItems": 250,
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      ]
    },
    "encounterConsequenceList": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type"]
      }
    },
    "encounterQuestEventList": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "encounterOutcomeRewardMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/encounterRewardSpec"
      }
    },
    "encounterOutcomeConsequenceMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/encounterConsequenceList"
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
        "summary": {
          "type": "string",
          "maxLength": 4000
        },
        "locationIds": {
          "$ref": "#/$defs/idList"
        },
        "questIds": {
          "$ref": "#/$defs/idList"
        },
        "checkpointIds": {
          "$ref": "#/$defs/idList"
        },
        "enemyIds": {
          "$ref": "#/$defs/idList"
        },
        "completion": {
          "type": "object",
          "additionalProperties": true
        },
        "setup": {
          "description": "Stored in the operator catalog only; never shown to players."
        },
        "stakes": {
          "description": "Stored in the operator catalog only; never shown to players."
        },
        "gmNotes": {
          "description": "Stored in the operator catalog only; never shown to players.",
          "$ref": "#/$defs/gmNotes"
        },
        "difficulty": {
          "description": "Stored in the operator catalog."
        },
        "tags": {
          "description": "Stored in the operator catalog.",
          "type": "array",
          "maxItems": 150,
          "items": {
            "type": "string",
            "maxLength": 120
          }
        },
        "reward": {
          "description": "Compatibility alias for common successful-outcome encounter rewards.",
          "$ref": "#/$defs/encounterRewardSpec"
        },
        "rewards": {
          "description": "Common rewards for victory, surrender, negotiation, or objective completion.",
          "$ref": "#/$defs/encounterRewardSpec"
        },
        "partyAllocation": {
          "description": "Default allocation policy by reward type. Supported values are split, each, first, and actor.",
          "oneOf": [
            {
              "type": "string",
              "enum": ["split", "each", "first", "actor"]
            },
            {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["split", "each", "first", "actor"]
              }
            }
          ]
        },
        "outcomes": {
          "description": "Outcome-specific rewards, consequences, quest events, and allocation policy. Prefer victory, defeat, retreat, surrender, negotiation, and objective_completion keys.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "outcomeRewards": {
          "description": "Compatibility map of combat outcome to reward specification.",
          "$ref": "#/$defs/encounterOutcomeRewardMap"
        },
        "outcomeConsequences": {
          "description": "Map of combat outcome to bounded state consequences.",
          "$ref": "#/$defs/encounterOutcomeConsequenceMap"
        },
        "questEvents": {
          "description": "Stable gameplay events offered to linked mechanical quests after the encounter ends.",
          "$ref": "#/$defs/encounterQuestEventList"
        },
        "onVictory": {
          "$ref": "#/$defs/encounterConsequenceList"
        },
        "onDefeat": {
          "$ref": "#/$defs/encounterConsequenceList"
        },
        "onRetreat": {
          "$ref": "#/$defs/encounterConsequenceList"
        },
        "onSurrender": {
          "$ref": "#/$defs/encounterConsequenceList"
        },
        "onNegotiation": {
          "$ref": "#/$defs/encounterConsequenceList"
        },
        "onObjectiveCompletion": {
          "$ref": "#/$defs/encounterConsequenceList"
        },
        "trigger": {
          "$ref": "#/$defs/encounterTrigger"
        },
        "once": {
          "description": "Fire the trigger only once (default true).",
          "type": "boolean"
        },
        "when": {
          "description": "The trigger fires only while this flag holds.",
          "$ref": "#/$defs/flagPredicate"
        },
        "unless": {
          "description": "The trigger does not fire while this flag holds.",
          "$ref": "#/$defs/flagPredicate"
        },
        "scaling": {
          "description": "Counts and HP are authored for four player characters and scale down for a smaller party; false disables that.",
          "type": "boolean"
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "summary": {
          "description": "Used as the segment description when description is absent.",
          "type": "string",
          "maxLength": 4000
        },
        "description": {
          "type": "string",
          "maxLength": 4000
        },
        "playerSummary": {
          "type": "string",
          "maxLength": 4000
        },
        "tone": {
          "type": "string",
          "maxLength": 4000
        },
        "gmNotes": {
          "$ref": "#/$defs/gmNotes"
        },
        "locationId": {
          "description": "Without a trigger, the segment triggers automatically when the party's current location is this location.",
          "$ref": "#/$defs/id"
        },
        "questIds": {
          "$ref": "#/$defs/idList"
        },
        "trigger": {
          "description": "A plain string is a comma-separated keyword list matched against the player's message. Without a trigger the segment is manual, unless it has a locationId.",
          "oneOf": [
            {
              "type": "string",
              "maxLength": 4000
            },
            {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "type": {
                  "enum": ["manual", "keyword", "keywords", "state", "location"]
                },
                "keywords": {
                  "description": "keyword triggers: a list (or comma-separated string) matched against the player's message.",
                  "type": ["array", "string"]
                },
                "match": {
                  "description": "keyword triggers: any (default) or all keywords must appear.",
                  "enum": ["any", "all"]
                },
                "location_contains": {
                  "description": "state triggers: substring of the current location name or id.",
                  "type": "string"
                },
                "quest_contains": {
                  "description": "state triggers: substring of an active quest's id, title, stage, summary or objectives.",
                  "type": "string"
                },
                "locationId": {
                  "description": "location triggers: fires when the current location id equals this id.",
                  "$ref": "#/$defs/id"
                }
              }
            }
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 120
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title"],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "maxLength": 160
        },
