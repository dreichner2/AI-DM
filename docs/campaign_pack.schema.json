          "type": "string",
          "maxLength": 4000
        },
        "summary": {
          "description": "Player-facing opening summary.",
          "type": "string",
          "maxLength": 4000
        },
        "visibleDetails": {
          "description": "Player-facing details of the opening scene.",
          "type": "array",
          "maxItems": 150,
          "items": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "hiddenSceneNotes": {
          "description": "GM-only notes kept on the opening scene; never shown to players.",
          "$ref": "#/$defs/gmNotes"
        },
        "interactables": {
          "description": "Opening-scene objects. When absent or empty, the starting location's own interactables are used.",
          "$ref": "#/$defs/objectList"
        },
        "hazards": {
          "description": "Opening-scene hazards. When absent or empty, the starting location's own hazards are used.",
          "$ref": "#/$defs/objectList"
