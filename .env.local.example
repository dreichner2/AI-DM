AIDM_LLM_PROVIDER=nvidia
AIDM_NVIDIA_API_KEY=YOUR_NVIDIA_OR_KIMI_KEY
AIDM_LLM_MODEL=moonshotai/kimi-k2.5
AIDM_LLM_FALLBACK_MODELS=
AIDM_NVIDIA_INVOKE_URL=https://integrate.api.nvidia.com/v1
AIDM_NVIDIA_THINKING=true
AIDM_NVIDIA_MAX_TOKENS=16384
AIDM_NVIDIA_TEMPERATURE=1.0
AIDM_NVIDIA_TOP_P=0.95
AIDM_NVIDIA_TIMEOUT_SECONDS=180
# DeepSeek narration (AIDM_LLM_PROVIDER=deepseek). Thinking is off by default for
# faster first words; with thinking on, max tokens is raised to at least 8192.
AIDM_DEEPSEEK_THINKING=false
AIDM_DEEPSEEK_MAX_TOKENS=2048
# Narrator voice. AIDM_TTS_PROVIDER is openai or deepgram; left unset, the server uses OpenAI when
# AIDM_OPENAI_API_KEY (or OPENAI_API_KEY) is set, else Deepgram when AIDM_DEEPGRAM_API_KEY is set.
# Keys live only in the server environment; players never type one in.
# AIDM_TTS_PROVIDER=openai
# AIDM_OPENAI_API_KEY=YOUR_OPENAI_KEY
# Model for a request that names no quality. Players choose Best (gpt-realtime-2.1) or
# Faster (gpt-realtime-2.1-mini) in Settings -> Sound.
AIDM_OPENAI_TTS_MODEL=gpt-realtime-2.1
# Default voice: cedar, marin, ash, ballad, coral, echo, sage, shimmer, verse or alloy.
AIDM_OPENAI_TTS_VOICE=cedar
# Default accent: default, british, northern, scottish, welsh or west_country.
AIDM_OPENAI_TTS_ACCENT=default
